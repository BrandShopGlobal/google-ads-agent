# Local mode: runs the complete workflow with safe sample data.
DEMO_MODE=true

# Supabase (required when DEMO_MODE=false)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (required when DEMO_MODE=false)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google OAuth + Google Ads (required when DEMO_MODE=false)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ADS_API_VERSION=v22

# Legacy only: leave blank unless the existing approved setup still requires it.
GOOGLE_ADS_DEVELOPER_TOKEN=
